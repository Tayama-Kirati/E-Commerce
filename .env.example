# Copy to .env and fill in. Never commit .env — it is gitignored.
# Required = the app won't work without it. Optional = the feature is switched off when unset.

# ── Core (required) ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Public URL of the site, used in emails, payment return URLs and the sitemap
NEXTAUTH_URL="http://localhost:3000"
# Random 32+ byte secret: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Optional override for canonical/SEO URLs (defaults to NEXTAUTH_URL)
NEXT_PUBLIC_SITE_URL=""

# ── Rate limiting & caching (recommended) ────────────────────────────────────
# Upstash Redis. Without it rate limits are skipped and search caching/trending is off.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Email (required for verification, password reset, order emails) ─────────
RESEND_API_KEY=""
EMAIL_FROM="PeaNut <orders@yourdomain.com>"

# ── Google sign-in (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Payments ─────────────────────────────────────────────────────────────────
# Khalti: test key from test-admin.khalti.com → Settings → API Keys
KHALTI_SECRET_KEY=""
# Leave unset for the sandbox; production: https://khalti.com/api/v2
KHALTI_BASE_URL=""
# Stripe card payments (optional — the Card option errors politely when unset)
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard:
#   URL: https://YOUR_DOMAIN/api/payments/stripe/webhook
#   Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET=""

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer token for GET /api/payments/reconcile (settles abandoned payments, releases stock)
CRON_SECRET=""

# ── SMS via Sparrow SMS (optional) ───────────────────────────────────────────
SPARROW_SMS_TOKEN=""
SPARROW_SMS_FROM=""

# ── Image uploads (optional — falls back to /public/uploads) ─────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── AI (optional) ────────────────────────────────────────────────────────────
# Chat assistant, AI search and product classification
ANTHROPIC_API_KEY=""
# Product summaries / embeddings (app/lib/openai.ts)
OPENAI_API_KEY=""
